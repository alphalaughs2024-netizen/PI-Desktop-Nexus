{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/*"],
      "@pi-desktop/shared": ["../../packages/shared/src/index.ts"],
      "@pi-desktop/shared/*": ["../../packages/shared/src/*"]
    },
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "electron/**/*",
    "electron.vite.config.ts"
  ]
}
